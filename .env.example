# ==============================================================================
# CodeArena Environment Variables (Example)
# ==============================================================================

# Application Environments: development | test | production
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=codearena
POSTGRES_PASSWORD=codearena_secret
POSTGRES_DB=codearena_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://codearena:codearena_secret@localhost:5433/codearena_db?schema=public

# Redis Configuration (BullMQ, Rate Limiting, Leaderboard, Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380

# API Server Configuration
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Web Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# JWT Secrets for Authentication
JWT_ACCESS_SECRET=codearena_super_secret_jwt_access_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=codearena_super_secret_jwt_refresh_key_change_in_production_32chars
JWT_REFRESH_EXPIRES_IN=7d

# Judge Worker Configuration
QUEUE_NAME=judge_submissions
JUDGE_CONCURRENCY=2
WORKER_PORT=4001
MAX_SOURCE_BYTES=65536
MAX_OUTPUT_BYTES=1048576
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_MB=256

# Rate Limiting
SUBMISSION_RATE_LIMIT_PER_MIN=6
AUTH_RATE_LIMIT_PER_MIN=10
